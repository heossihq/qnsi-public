{
	"name": "@heossihq/qnsi",
	"version": "0.7.0",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"license": "Apache-2.0",
	"description": "Official Node.js / TypeScript SDK for QNSI. Typed clients for mounted vault, KMS, audit, auth, tenant, access-control, billing, crypto-inventory, storage, search, and AI routes, plus local PQC utilities and webhook verification.",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./activation": {
			"types": "./dist/_activation/index.d.ts",
			"import": "./dist/_activation/index.js"
		},
		"./browser": {
			"types": "./dist/browser/index.d.ts",
			"import": "./dist/browser/index.js"
		},
		"./langchain": {
			"types": "./dist/langchain/index.d.ts",
			"import": "./dist/langchain/index.js"
		},
		"./llamaindex": {
			"types": "./dist/llamaindex/index.d.ts",
			"import": "./dist/llamaindex/index.js"
		},
		"./autogen": {
			"types": "./dist/autogen/index.d.ts",
			"import": "./dist/autogen/index.js"
		},
		"./code-scan": {
			"types": "./dist/code-scan/index.d.ts",
			"import": "./dist/code-scan/index.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"qnsi": "./dist/cli/index.js"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"lint": "biome check .",
		"test": "vitest run",
		"typecheck": "tsc --project tsconfig.json --noEmit && tsc --project examples/tsconfig.json --noEmit",
		"test:integration:live": "vitest run --config vitest.integration.config.ts",
		"verify:production": "pnpm test:integration:live"
	},
	"dependencies": {
		"@noble/hashes": "^2.4.0",
		"@noble/post-quantum": "^0.7.1",
		"commander": "^15.0.0",
		"dotenv": "^18.0.1",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"@langchain/core": ">=0.3.0",
		"llamaindex": ">=0.5.0"
	},
	"peerDependenciesMeta": {
		"@langchain/core": {
			"optional": true
		},
		"llamaindex": {
			"optional": true
		}
	},
	"devDependencies": {
		"@heossihq/qnsi-enforcement-contract": "workspace:*",
		"@langchain/core": "^1.2.12",
		"@types/node": "^26.6.2",
		"typescript": "^7.0.2",
		"vitest": "5.0.1"
	},
	"engines": {
		"node": ">=24.18.0"
	},
	"keywords": [
		"qnsi",
		"sdk",
		"post-quantum",
		"pqc",
		"vault",
		"kms",
		"audit",
		"auth",
		"tenant",
		"billing",
		"storage",
		"search",
		"ai",
		"ml-kem",
		"ml-dsa",
		"slh-dsa",
		"fips-203",
		"fips-204",
		"fips-205",
		"quantum-safe",
		"zero-trust"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/heossihq/qnsi-public",
		"directory": "packages/qnsi"
	},
	"homepage": "https://qnsi.heossi.com",
	"bugs": {
		"url": "https://github.com/heossihq/qnsi-public/issues"
	},
	"files": [
		"dist/**/*",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	]
}
