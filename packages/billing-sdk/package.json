{
	"name": "@heossi/qnsi-billing-sdk",
	"version": "0.2.6",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"license": "Apache-2.0",
	"description": "TypeScript SDK client for the QNSP billing-service API. Provides usage meter ingestion and invoice management.",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsx watch src/index.ts",
		"lint": "biome check .",
		"test": "vitest run",
		"typecheck": "tsc --project tsconfig.json --noEmit"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.214.0",
		"@opentelemetry/resources": "^2.6.1",
		"@opentelemetry/sdk-metrics": "^2.6.1",
		"@heossi/qnsi-sdk-activation": "workspace:*",
		"undici": "^8.0.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/node": "^25.5.2",
		"tsx": "^4.21.0",
		"vitest": "4.1.2"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"keywords": [
		"qnsp",
		"pqc",
		"post-quantum",
		"post-quantum-cryptography",
		"billing",
		"metering",
		"subscriptions",
		"invoices",
		"usage-metering",
		"payments",
		"saas-billing",
		"quantum-safe",
		"typescript",
		"nodejs",
		"sdk"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/heossihq/qnsi-public",
		"directory": "packages/billing-sdk"
	},
	"homepage": "https://cloud.qnsi.heossi.com",
	"bugs": {
		"url": "https://github.com/heossihq/qnsi-public/issues"
	},
	"files": [
		"dist/**/*",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	]
}
