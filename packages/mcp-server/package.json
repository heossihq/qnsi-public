{
	"name": "@heossihq/qnsi-mcp",
	"version": "0.4.1",
	"description": "QNSI MCP server for PQC keys, HSPK custody, encrypted vault, crypto inventory, audit, search, storage, and manifest operation discovery.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=24.18.0"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"bin": {
		"qnsi-mcp": "./dist/index.js"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./tools": {
			"import": "./dist/tools.js",
			"types": "./dist/tools.d.ts"
		},
		"./session": {
			"import": "./dist/session.js",
			"types": "./dist/session.d.ts"
		},
		"./api-client": {
			"import": "./dist/api-client.js",
			"types": "./dist/api-client.d.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"lint": "biome check .",
		"test": "vitest run",
		"typecheck": "tsc --project tsconfig.json --noEmit"
	},
	"dependencies": {
		"@heossihq/qnsi": "workspace:*",
		"@modelcontextprotocol/sdk": "^1.32.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@heossihq/qnsi-enforcement-contract": "workspace:*",
		"@types/node": "^26.6.2",
		"typescript": "^7.0.2",
		"vitest": "5.0.1"
	},
	"keywords": [
		"qnsi",
		"mcp",
		"model-context-protocol",
		"pqc",
		"post-quantum",
		"post-quantum-cryptography",
		"ml-kem",
		"ml-dsa",
		"kyber",
		"dilithium",
		"hqc",
		"bike",
		"frodokem",
		"mayo",
		"cross",
		"sphincs",
		"falcon",
		"cryptography",
		"kms",
		"key-management",
		"vault",
		"secrets",
		"audit",
		"quantum-safe",
		"zero-trust",
		"fips-203",
		"fips-204",
		"fips-205",
		"nist",
		"compliance",
		"ai-tools",
		"smithery"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/heossihq/qnsi-public",
		"directory": "packages/mcp-server"
	},
	"homepage": "https://qnsi.heossi.com",
	"bugs": {
		"url": "https://github.com/heossihq/qnsi-public/issues"
	}
}
