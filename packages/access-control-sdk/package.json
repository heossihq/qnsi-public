{
	"name": "@heossihq/qnsi-access-control-sdk",
	"version": "0.3.6",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"license": "Apache-2.0",
	"description": "TypeScript SDK client for the QNSI access-control-service API. Provides policy management and capability token operations.",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsx watch src/index.ts",
		"lint": "biome check .",
		"test": "vitest run",
		"typecheck": "tsc --project tsconfig.json --noEmit"
	},
	"dependencies": {
		"@heossihq/qnsi-sdk-activation": "workspace:*",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
		"@opentelemetry/resources": "^2.11.0",
		"@opentelemetry/sdk-metrics": "^2.11.0",
		"undici": "^8.10.2",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"tsx": "^4.23.15",
		"vitest": "5.0.1"
	},
	"engines": {
		"node": ">=24.18.0"
	},
	"keywords": [
		"qnsi",
		"pqc",
		"post-quantum",
		"post-quantum-cryptography",
		"access-control",
		"rbac",
		"abac",
		"permissions",
		"policy",
		"authorization",
		"opa",
		"zero-trust",
		"quantum-safe",
		"typescript",
		"nodejs",
		"sdk"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/heossihq/qnsi-public",
		"directory": "packages/access-control-sdk"
	},
	"homepage": "https://cloud.qnsi.heossi.com",
	"bugs": {
		"url": "https://github.com/heossihq/qnsi-public/issues"
	},
	"files": [
		"dist/**/*",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"private": true
}
