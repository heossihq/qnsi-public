{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"ignoreDeprecations": "6.0",
		"rootDir": "src",
		"composite": true,
		"tsBuildInfoFile": "tsconfig.tsbuildinfo",
		"paths": {
			"@heossihq/qnsi-observability": ["../observability/dist/index.d.ts"],
			"@heossihq/qnsi-*": ["../*/src"],
			"@heossihq/qnsi-app/*": ["../../apps/*/src"]
		}
	},
	"include": ["src/**/*.ts"],
	"exclude": ["dist", "build"]
}
