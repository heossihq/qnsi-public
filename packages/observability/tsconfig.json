{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"ignoreDeprecations": "6.0",
		"rootDir": "src",
		"paths": {
			"@heossihq/qnsi-shared-kernel": ["../shared-kernel/dist/index.d.ts"],
			"@heossihq/qnsi-shared-kernel/errors": ["../shared-kernel/dist/errors/index.d.ts"],
			"@heossihq/qnsi-shared-kernel/errors/http-client": [
				"../shared-kernel/dist/errors/http-client.d.ts"
			]
		},
		"composite": true,
		"tsBuildInfoFile": "tsconfig.tsbuildinfo"
	},
	"include": ["src/**/*.ts"],
	"exclude": ["dist", "build"]
}
