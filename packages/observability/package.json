{
	"name": "@heossihq/qnsi-observability",
	"version": "0.1.4",
	"license": "Apache-2.0",
	"engines": {
		"node": ">=24.18.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"description": "OpenTelemetry-based observability primitives for the QNSI quantum-native security infrastructure: metrics, distributed tracing, and structured logging. Free tier at cloud.qnsi.heossi.com.",
	"keywords": [
		"qnsi",
		"observability",
		"opentelemetry",
		"otel",
		"metrics",
		"tracing",
		"prometheus",
		"pqc",
		"post-quantum",
		"typescript",
		"nodejs",
		"quantum-safe"
	],
	"homepage": "https://cloud.qnsi.heossi.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/heossihq/qnsi-public",
		"directory": "packages/observability"
	},
	"bugs": {
		"url": "https://github.com/heossihq/qnsi-public/issues"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsx watch src/index.ts",
		"lint": "biome check .",
		"test": "vitest run",
		"typecheck": "tsc --project tsconfig.json --noEmit"
	},
	"dependencies": {
		"@heossihq/qnsi-shared-kernel": "workspace:*",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/resources": "^2.11.0",
		"@opentelemetry/sdk-metrics": "^2.11.0",
		"@opentelemetry/sdk-trace-node": "^2.11.0",
		"fastify": "^5.12.5"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"vitest": "5.0.1"
	},
	"private": true
}
