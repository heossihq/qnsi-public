{
	"name": "@heossihq/liboqs-native",
	"version": "0.16.0",
	"type": "commonjs",
	"license": "BUSL-1.1",
	"description": "Native liboqs bindings wrapper for the QNSI platform.",
	"liboqsVersion": "0.16.0",
	"publishConfig": {
		"registry": "https://registry.npmjs.org/",
		"access": "public"
	},
	"files": [
		"dist/**/*",
		"prebuilds/**/*"
	],
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json && pnpm run check-dist",
		"build:debug": "node-gyp rebuild --debug",
		"build:native": "node ./tools/build.js",
		"check-dist": "node ./tools/check-dist.js",
		"lint": "biome check src tools vendor/path-key-shim.js",
		"prepare": "pnpm run check-dist",
		"prepublishOnly": "pnpm run build && pnpm run build:native",
		"test": "vitest run --coverage",
		"typecheck": "tsc --project tsconfig.json --noEmit",
		"install": "node ./tools/install.js"
	},
	"engines": {
		"node": ">=24.18.0"
	},
	"dependencies": {
		"node-addon-api": "^8.9.2",
		"node-gyp-build": "^4.8.4"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"@vitest/coverage-v8": "5.0.1",
		"node-gyp": "^13.0.2",
		"prebuildify": "^6.0.1",
		"typescript": "^7.0.2",
		"vitest": "5.0.1"
	},
	"private": true
}
