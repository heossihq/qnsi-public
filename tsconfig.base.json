{
	"$schema": "https://json.schemastore.org/tsconfig",
	"compilerOptions": {
		"ignoreDeprecations": "6.0",
		"target": "ES2022",
		"module": "NodeNext",
		"lib": ["ES2023"],
		"moduleResolution": "nodenext",
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noPropertyAccessFromIndexSignature": true,
		"useUnknownInCatchVariables": true,
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"types": ["node"],
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"exactOptionalPropertyTypes": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"baseUrl": ".",
		"paths": {
			"@heossihq/qnsi-config": ["packages/config/src"],
			"@heossihq/qnsi-shared-kernel": ["packages/shared-kernel/src"],
			"@heossihq/qnsi-shared-kernel/db": ["packages/shared-kernel/dist/db.d.ts"],
			"@heossihq/qnsi-shared-kernel/errors": ["packages/shared-kernel/src/errors/index.ts"],
			"@heossihq/qnsi-shared-kernel/errors/http-client": [
				"packages/shared-kernel/src/errors/http-client.ts"
			],
			"@heossihq/qnsi-shared-kernel/server": ["packages/shared-kernel/dist/server.d.ts"],
			"@heossihq/qnsi-logging": ["packages/logging/src"],
			"@heossihq/qnsi-observability": ["packages/observability/src"],
			"@heossihq/qnsi-cryptography": ["packages/cryptography/src"],
			"@heossihq/qnsi-cryptography/*": ["packages/cryptography/src/*"],
			"@heossihq/qnsi-security": ["packages/security/dist/index.d.ts"],
			"@heossihq/qnsi-security/*": ["packages/security/dist/*"],
			"@heossihq/qnsi-resilience": ["packages/resilience/src"],
			"@heossihq/qnsi-cache": ["packages/cache/src"],
			"@heossihq/qnsi-feature-flags": ["packages/feature-flags/src"],
			"@heossihq/qnsi-slo": ["packages/slo/src"],
			"@heossihq/qnsi-auth-sdk": ["packages/auth-sdk/dist/index.d.ts"],
			"@heossihq/qnsi-*": ["packages/*/src"],
			"@heossihq/qnsi-app/*": ["apps/*/src"]
		}
	},
	"exclude": ["node_modules", "dist", "build"],
	"include": []
}
